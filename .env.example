# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Database (Supabase Postgres) ---------------------------------------
# Use the "Direct connection" string from Supabase (Project Settings ->
# Database -> Connection string -> URI, mode "Direct"). Port 5432.
# If you later deploy to serverless (e.g. Vercel functions), switch to the
# pooled "Transaction" connection string (port 6543, add ?pgbouncer=true).
DATABASE_URL="postgresql://postgres:<password>@<host>:5432/postgres"

# Optional: only used by `prisma migrate dev` for drift detection. Point it
# at a scratch database (never the same as DATABASE_URL).
# SHADOW_DATABASE_URL=""

# Optional: Supabase Management API personal access token + project ref.
# Only needed if you want DB/project admin (e.g. password resets) done
# without opening the Supabase dashboard. Generate at
# https://supabase.com/dashboard/account/tokens — scoped to your whole
# Supabase account, treat as a high-privilege secret.
# SUPABASE_ACCESS_TOKEN=""
# SUPABASE_PROJECT_REF=""

# --- Segredos de conexões de canais (WhatsApp/etc.) -------------------------
# Chave AES-256 (32 bytes, base64) usada para criptografar credenciais de
# provedores de canal (ex: token da Z-API) em repouso. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY="replace-with-a-random-32-byte-base64-key"

# --- Campanhas (disparo em massa de WhatsApp) -------------------------------
# Segredo compartilhado que autoriza o pinger externo (ex: cron-job.org) a
# chamar /api/cron/campaign-dispatcher — não há worker/cron nativo nesta
# infra (Supabase + Vercel serverless), então o disparo é acionado de fora,
# de 1 em 1 minuto, com header "Authorization: Bearer <valor>". Generate with:
# openssl rand -base64 32
CRON_DISPATCH_SECRET="replace-with-a-random-secret"

# --- Better Auth ----------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"

# --- Atendente de IA no WhatsApp (Vercel AI Gateway) ------------------------
# Autentica as chamadas de geração de texto do atendente (ver
# bot-attendant.service.ts). Qual modelo usar ("provider/model") é
# configurado pelo Super Admin em /admin/whatsapp, não aqui — esta chave só
# autentica o app com o AI Gateway. Gerar em https://vercel.com/ai-gateway.
AI_GATEWAY_API_KEY="replace-with-your-ai-gateway-api-key"

# --- Busca de endereço do atendente (Google Maps Geocoding API) ------------
# Mesma chave que o app de mobilidade (MAI Drive) já usa pra buscar
# endereço — reaproveitar em vez de contratar um provedor novo. Só precisa
# ter a "Geocoding API" habilitada no Google Cloud Console. Opcional: sem
# essa chave, o atendente simplesmente não confere o endereço antes de
# confirmar a corrida (ver buscarEndereco em bot-attendant.service.ts).
GOOGLE_MAPS_API_KEY="replace-with-your-google-maps-api-key"

# --- Chave direta da Anthropic (opcional — BYOK) ----------------------------
# Gerada em console.anthropic.com. Só serve como referência/backup local —
# quem efetivamente usa isso em produção é o BYOK configurado no painel do
# AI Gateway da Vercel (AI Gateway > Bring Your Own Key), não uma leitura
# direta deste arquivo pelo app.
ANTHROPIC_API_KEY="replace-with-your-anthropic-api-key"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Seed: initial platform admin user (prisma/seed.ts) ---------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
