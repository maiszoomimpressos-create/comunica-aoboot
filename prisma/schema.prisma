// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// BETTER AUTH — identidade, sessão, organização (multiempresa), convites
// =====================================================================
// Campos e nomes de modelo escritos à mão para casar exatamente com o que
// o Better Auth (core + plugins organization/admin) espera via seu adapter
// Prisma — não gerados pelo `@better-auth/cli` porque essa CLI depende de
// better-sqlite3 (compilação nativa via node-gyp/Python), indisponível
// neste ambiente. Conferido campo a campo contra
// node_modules/@better-auth/core/dist/db/get-tables.mjs e
// node_modules/better-auth/dist/plugins/{admin,organization}/schema.d.mts.

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // plugin: admin
  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[] @relation("InvitationInviter")
  auditLogs   AuditLog[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // plugin: admin (impersonation)
  impersonatedBy String?

  // plugin: organization (tenant ativo é resolvido pela URL, não por isto —
  // ver lib/server/request-context.ts; mantido só pelo Better Auth internamente)
  activeOrganizationId String?
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logo      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  // additionalFields do plugin organization (ver lib/auth/auth.ts)
  primaryColor        String?
  status              TenantStatus @default(ACTIVE)
  // Nome exibido nas mensagens automáticas (ex.: confirmação de compra do
  // WhatsApp) — pode ser diferente de `name` (ex.: "tipo7.com" em vez da
  // razão social). Opcional: cai no `name` quando não preenchido.
  messageBusinessName String?

  members        Member[]
  invitations    Invitation[]
  activeSessions Session[]

  // domínio próprio (RBAC granular, planos, marketplace, auditoria)
  roles                 Role[]
  subscription          Subscription?
  tenantModules         TenantModule[]
  auditLogs             AuditLog[]
  communicationChannels CommunicationChannel[]
  channelConnections    ChannelConnection[]
  contacts              Contact[]
  contactLists          ContactList[]
  campaigns             Campaign[]
  setores               Setor[]
  segmentos             Segmento[]

  @@index([status])
  @@map("organization")
}

model Member {
  id        String   @id @default(cuid())
  role      String   @default("member")
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id        String    @id @default(cuid())
  email     String
  role      String
  status    String    @default("pending")
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  inviterId String
  inviter   User   @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitation")
}

// =====================================================================
// RBAC granular — customizável por tenant (não coberto pelo Better Auth)
// =====================================================================

model Permission {
  id          String @id @default(cuid())
  code        String @unique // ex: "members.invite", "billing.manage"
  category    String
  description String

  rolePermissions RolePermission[]

  @@map("permission")
}

model Role {
  id        String   @id @default(cuid())
  key       String // "owner" | "admin" | "member" | "billing" | slug custom
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // false (default) = papel enxerga todas as conexões do tenant,
  // RoleConnectionScope é ignorada. true = só as conexões listadas em
  // connectionScopes, mesmo que a lista esteja vazia (estado intencional
  // de "ainda não vejo nenhuma conexão") — ver require-permission.ts /
  // connection-scope.ts pra por que isso não é "zero linhas = liberado".
  connectionScopeEnabled Boolean @default(false)

  tenantId     String
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  rolePermissions  RolePermission[]
  connectionScopes RoleConnectionScope[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("role")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

// Conexões que um papel restrito pode acessar — só é lida quando
// Role.connectionScopeEnabled = true (ver comentário no model Role).
// Apagar a ChannelConnection apaga a linha junto (onDelete: Cascade), então
// remover uma conexão nunca deixa um escopo "fantasma" nem aumenta acesso
// de ninguém por engano.
model RoleConnectionScope {
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([roleId, connectionId])
  @@map("role_connection_scope")
}

// =====================================================================
// Planos / assinaturas (estrutura pronta — sem gateway de pagamento real)
// =====================================================================

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model Plan {
  id         String          @id @default(cuid())
  name       String
  slug       String          @unique
  priceCents Int
  currency   String          @default("BRL")
  interval   BillingInterval @default(MONTHLY)
  features   Json
  isActive   Boolean         @default(true)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  subscriptions Subscription[]

  @@map("plan")
}

model Subscription {
  id                     String             @id @default(cuid())
  status                 SubscriptionStatus @default(TRIALING)
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  externalCustomerId     String?
  externalSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  tenantId     String       @unique
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  @@map("subscription")
}

// =====================================================================
// Marketplace de módulos — só estrutura visual + banco nesta fase
// =====================================================================

model Module {
  id           String   @id @default(cuid())
  key          String   @unique // "whatsapp" | "telegram" | "instagram" | "email" | "sms" | "payments"
  name         String
  description  String
  icon         String?
  category     String
  isComingSoon Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantModules TenantModule[]

  @@map("module")
}

enum TenantModuleStatus {
  NOT_INSTALLED
  INSTALLED
  COMING_SOON
}

model TenantModule {
  id          String             @id @default(cuid())
  status      TenantModuleStatus @default(NOT_INSTALLED)
  installedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenantId     String
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
  @@map("tenant_module")
}

// =====================================================================
// Canais de comunicação — Empresa → Canal → Provedor → Conexão
// =====================================================================
// Desenho genérico para múltiplos canais (whatsapp/email/sms/telegram) e
// múltiplos provedores por canal, para que trocar/adicionar um provedor
// (ex.: Meta Cloud API, Evolution API) não exija tabelas novas — só um novo
// valor de enum + uma nova linha em ChannelProvider + uma nova implementação
// de provider em src/lib/whatsapp (ver PROVIDER_ABSTRACTION).

enum CommunicationChannelType {
  WHATSAPP
  EMAIL
  SMS
  TELEGRAM
}

enum ChannelConnectionStatus {
  PENDING
  CONNECTING
  // Credentials are valid (instance reachable, Client-Token accepted) but
  // the WhatsApp session itself hasn't been paired to a phone yet — the
  // tenant (whoever has the phone) needs to scan the QR code. Distinct
  // from AUTH_ERROR, which is a real problem; this is an expected,
  // temporary step in normal setup.
  AWAITING_QR_SCAN
  CONNECTED
  AUTH_ERROR
  UNAVAILABLE
  INVALID_TOKEN
  ERROR
}

model CommunicationChannel {
  id        String                   @id @default(cuid())
  type      CommunicationChannelType
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  tenantId     String
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  connections ChannelConnection[]

  @@unique([tenantId, type])
  @@map("communication_channel")
}

model ChannelProvider {
  id          String                   @id @default(cuid())
  key         String                   @unique // "z-api" | "meta-cloud" | "evolution"
  name        String
  channelType CommunicationChannelType
  isActive    Boolean                  @default(false)
  sortOrder   Int                      @default(0)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  connections ChannelConnection[]

  @@map("channel_provider")
}

model ChannelConnection {
  id             String                  @id @default(cuid())
  connectionName String
  phoneNumber    String
  // Nome exibido nas mensagens automáticas desta conexão (ex.: confirmação
  // de compra) — sobrepõe Organization.messageBusinessName quando
  // preenchido. Uma conta pode administrar várias conexões/clientes
  // diferentes; esse campo deixa cada uma se identificar com seu próprio
  // nome, em vez de herdar o nome de negócio da conta inteira.
  businessName String?
  // Nulos enquanto a conexão está só "solicitada" (status PENDING) — o
  // tenant não digita mais isso, quem preenche é um admin da plataforma em
  // /admin/whatsapp (ver whatsapp-connection.service.ts: provisionConnection).
  apiUrl         String?
  apiTokenCipher String? // apiToken criptografado (AES-256-GCM) — nunca em texto puro, ver lib/crypto/secret-box.ts
  status         ChannelConnectionStatus @default(PENDING)
  lastValidation DateTime?
  lastError      String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  // Chave de API pra chamadas máquina-a-máquina (ver lib/api/v1/api-key-handler.ts).
  // Só o hash é salvo; o texto puro é mostrado uma única vez na hora de gerar.
  apiKeyHash       String?   @unique
  apiKeyPrefix     String? // ex: "bw_live_a1b2c3d4" — só identificação visual, nunca a chave inteira de novo
  apiKeyCreatedAt  DateTime?
  apiKeyLastUsedAt DateTime?

  // Segredo próprio pra autenticar webhooks recebidos da Z-API (ver
  // app/api/webhooks/zapi/[connectionId]/route.ts) — gerado sob demanda,
  // nunca reaproveita a chave de API pública (superfícies diferentes:
  // uma autentica quem nos chama, a outra autentica quem a Z-API chama).
  webhookSecret String?

  // Números fixos (até 3) que recebem o alerta de saldo baixo disparado
  // pelo sistema externo do tenant via POST /api/v1/whatsapp/balance-alert
  // — cadastrados pelo tenant no painel, nunca enviados pelo chamador da
  // API (ver sendBalanceAlert em whatsapp-connection.service.ts).
  balanceAlertPhones String[] @default([])

  // Quais serviços (src/config/whatsapp-services.ts) a chave de API desta
  // conexão pode chamar — "purchase_confirmation" vem habilitado por
  // padrão em toda conexão (nova ou já existente) pra nunca quebrar a
  // integração de ingresso já em produção; "balance_alert" é opt-in.
  enabledServices String[] @default(["purchase_confirmation"])

  // Quais tipos de notificação (config/whatsapp-notification-types.ts) esta
  // conexão pode disparar via sendPurchaseConfirmation — substitui o gate
  // amplo por serviceKey só para os tipos que vivem dentro de
  // purchase_confirmation/verification_code; balance_alert continua
  // controlado só por enabledServices (não tem "tipos").
  enabledNotificationTypes String[] @default(["compra_confirmada"])

  tenantId     String
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  channelId String
  channel   CommunicationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  providerId String
  provider   ChannelProvider @relation(fields: [providerId], references: [id])

  webhookEvents WebhookEvent[]

  contacts         Contact[]
  contactLists     ContactList[]
  campaigns        Campaign[]
  campaignSettings ConnectionCampaignSettings?

  botConfig                BotConfig?
  botConversations         BotConversation[]
  processedWebhookMessages ProcessedWebhookMessage[]
  aiUsageLogs              AiUsageLog[]
  businessIntegration      BusinessIntegration?
  setores                  Setor[]
  relaySessions            RelaySession[]
  flows                    Flow[]
  flowSessions             FlowSession[]
  formSubmissions          FormSubmission[]
  knowledgeEntries         KnowledgeEntry[]
  knowledgeCorrections     KnowledgeCorrection[]
  customNotificationTypes  CustomNotificationType[]
  segmentos                Segmento[]
  roleScopes               RoleConnectionScope[]

  @@index([tenantId, channelId])
  @@map("channel_connection")
}

enum SegmentoNiche {
  EVENTOS_INGRESSOS
  ESTACIONAMENTO
  MOBILIDADE_CORRIDAS
  GENERICO_2FA
}

// Rótulo de nicho de negócio que o tenant declara dentro da empresa — não é
// a mesma coisa que ChannelConnection: um segmento sempre aponta pra UMA
// conexão, mas uma conexão pode servir vários segmentos (ver "nova
// instância" vs "instância existente" em create-segmento.ts). Acesso é
// controlado pela conexão por baixo (ver Role.connectionScopeEnabled),
// nunca pelo segmento em si — isolamento de dado real só existe por
// connectionId.
model Segmento {
  id    String        @id @default(cuid())
  name  String
  niche SegmentoNiche

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId     String
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([connectionId])
  @@map("segmento")
}

// Tipo de notificação criado pelo próprio tenant (via "Funções" → "Criar
// função personalizada") pra negócios fora do catálogo fixo de
// whatsapp-notification-types.ts — campos e texto gerados por IA a partir
// de uma descrição livre, revisáveis antes de salvar. Ver sendPurchaseConfirmation
// em whatsapp-connection.service.ts pra como isso entra no envio real.
// Estilo de saudação das funções personalizadas (CustomNotificationType /
// FunctionTemplate) — FIXO é o "Olá, {nome}!" de sempre; HORARIO varia
// Bom dia/Boa tarde/Boa noite conforme o horário de envio em
// America/Sao_Paulo (ver buildGreeting em whatsapp-notification-types.ts).
enum CustomGreetingStyle {
  FIXO
  HORARIO
}

// De onde vem o nome usado na saudação: o nome do perfil do WhatsApp da
// pessoa (pode vir nulo/estranho) ou o nome cadastrado pelo sistema que
// chama a API (`recipientName` — sempre preenchido, mais confiável).
enum CustomGreetingNameSource {
  PERFIL_WHATSAPP
  CADASTRO
}

model CustomNotificationType {
  id String @id @default(cuid())

  // Slug gerado a partir do título (ex: "Corrida concluída MAI Drive" →
  // corrida_concluida_mai_drive) — é o que o sistema externo manda em
  // `type`. Editável na revisão antes de salvar, mas nunca depois de salvo.
  key   String
  label String

  // O texto livre original digitado pelo tenant — vira a "descrição"
  // mostrada no painel de Funções, mesmo papel do `description` do
  // catálogo fixo.
  description String

  // Array de {key, label, description?, required?} extraído pela IA a
  // partir da descrição — `required` ausente/true = obrigatório (igual ao
  // comportamento antigo, antes de campo opcional existir); `false` = a
  // linha correspondente no messageTemplate some quando o valor não vier
  // (mesmo tratamento dos campos opcionais do catálogo fixo).
  fields Json

  // Corpo da mensagem com {{campo}} como placeholder — NÃO inclui
  // saudação; isso é sempre prefixado automaticamente no envio (ver
  // buildGreeting em whatsapp-notification-types.ts). `{{nome_empresa}}` é
  // um placeholder reservado: resolvido automaticamente a partir da
  // conexão, não precisa ser declarado em `fields`.
  messageTemplate String

  greetingStyle      CustomGreetingStyle      @default(FIXO)
  greetingNameSource CustomGreetingNameSource @default(PERFIL_WHATSAPP)

  requiresQr Boolean @default(false)

  // Soft-delete: preenchido na exclusão. O registro permanece no banco
  // para sempre; some da lista e deixa de ser disparável.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, key])
  @@map("custom_notification_type")
}

// Catálogo global de funções mantido pelo Super Admin (/admin/whatsapp) —
// diferente de CustomNotificationType (por conexão, criado pelo tenant),
// este é o mesmo pra toda a plataforma: o admin cadastra uma vez ("Corrida
// concluída") e qualquer tenant de qualquer empresa pode escolher esse card
// ao montar as Funções da conexão dele, em vez de descrever do zero pra IA.
// Mesmo formato de campos/template de CustomNotificationType de propósito —
// na hora de "adotar" um FunctionTemplate, o tenant só recebe uma cópia
// pré-preenchida (vira um CustomNotificationType normal da conexão dele,
// editável depois sem afetar o template original).
model FunctionTemplate {
  id String @id @default(cuid())

  // Slug curto, único na plataforma — é o `key` sugerido quando o tenant
  // adota esse template (pode ser editado na cópia dele, igual ao draft de
  // IA já permite).
  key         String  @unique
  label       String
  description String

  // Mesmo formato de CustomNotificationType.fields: array de {key, label,
  // description?, required?} — ver comentário lá pro significado de
  // `required`.
  fields          Json
  messageTemplate String

  greetingStyle      CustomGreetingStyle      @default(FIXO)
  greetingNameSource CustomGreetingNameSource @default(PERFIL_WHATSAPP)

  requiresQr Boolean @default(false)

  // Nicho(s) de negócio sugeridos pra este template (ver SegmentoNiche) —
  // puramente pra ordenar/destacar na tela do tenant, igual ao campo
  // `niches` do catálogo fixo em whatsapp-notification-types.ts. Vazio =
  // genérico, aparece pra qualquer nicho.
  niches SegmentoNiche[]

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("function_template")
}

// Biblioteca de "pedaços" de campo prontos, curada só pelo Super Admin —
// cada um é um único dado (ex: "valor", "nome do motorista") com a linha de
// mensagem já pronta. Existe pra evitar que cada tenant precise descrever
// pra IA (ou digitar na mão) os mesmos campos comuns toda vez que cria uma
// função personalizada: no formulário de criação, o tenant marca quais
// pedaços quer, e o sistema já monta fields+messageTemplate sozinho, sem
// chamar IA — cai na mesma tela de revisão de sempre, onde ele ainda pode
// editar tudo antes de salvar (ver create-custom-notification-type-form.tsx).
// Depois de montado, vira um CustomNotificationType normal — editável sem
// nenhum vínculo de volta com os pedaços usados (mesmo modelo "compõe uma
// vez" do FunctionTemplate, não uma referência viva).
model NotificationFieldBlock {
  id String @id @default(cuid())

  // snake_case, único na plataforma — é a {{chave}} usada em `messageLine`.
  key   String @unique
  label String

  // Linha de mensagem pronta pra esse campo (ex: "💰 Valor: {{valor}}") —
  // DEVE referenciar `{{key}}` dentro do texto; validado na criação/edição
  // (ver notification-field-block.service.ts).
  messageLine String

  // Legenda curta opcional explicando o pedaço — mostrada no checklist do
  // tenant, mesmo papel do `description` por campo de CustomNotificationField.
  description String?

  // Se marcado por padrão como obrigatório ao ser selecionado — o tenant
  // ainda pode mudar na revisão antes de salvar, igual a qualquer campo.
  defaultRequired Boolean @default(true)

  // Nicho(s) sugeridos — puramente pra agrupar/destacar no checklist do
  // tenant, mesmo princípio de FunctionTemplate.niches. Vazio = genérico,
  // aparece em qualquer grupo.
  niches SegmentoNiche[]

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_field_block")
}

// Log bruto dos eventos recebidos via webhook (mensagem recebida, status de
// entrega/leitura, conexão/desconexão, ...) — guardado sem interpretar o
// formato ainda; a leitura/uso desses dados é trabalho futuro (ver plano).
model WebhookEvent {
  id           String            @id @default(cuid())
  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // "z-api" hoje — mesmo valor de ChannelProvider.key, deixa espaço pra
  // outros provedores mais pra frente sem mudar o formato da tabela.
  source     String
  payload    Json
  receivedAt DateTime @default(now())

  @@index([connectionId, receivedAt])
  @@map("webhook_event")
}

// Trava de idempotência pro pipeline do atendente de IA — a Z-API manda o
// webhook de mensagem de áudio DUAS VEZES pro mesmo messageId (confirmado
// em produção, alguns segundos de diferença entre as duas entregas), o que
// fazia o atendente processar e responder duas vezes (e gastar em dobro).
// `@@unique` em [connectionId, messageId] faz o INSERT falhar na segunda
// entrega — tentativa de criar como trava atômica, sem janela de corrida
// entre checar e gravar. Ver tryClaimInboundMessage em bot.repository.ts.
model ProcessedWebhookMessage {
  id           String            @id @default(cuid())
  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  messageId    String
  processedAt  DateTime          @default(now())

  @@unique([connectionId, messageId])
  @@map("processed_webhook_message")
}

// =====================================================================
// Campanhas — disparo em massa de WhatsApp (fila persistente)
// =====================================================================
// Vive em cima de ChannelConnection: a mesma conexão que já serve
// Confirmação de Compra pode servir Campanhas também (produto "campanhas"
// em config/whatsapp-products.ts), ou o tenant conecta um número dedicado
// — a escolha é dele, nada aqui força uma coisa ou outra.

model Contact {
  id             String    @id @default(cuid())
  phone          String
  name           String?
  // "sync" = capturado da agenda do WhatsApp conectado; "import" = veio de
  // um CSV importado (ver importContactsFromCsv). Cadastro manual
  // avulso continua fora de escopo.
  source         String    @default("sync")
  optedOut       Boolean   @default(false)
  optedOutAt     DateTime?
  // "keyword" (respondeu SAIR/PARAR/...) | "manual" (bloqueio pelo painel)
  optedOutSource String?
  // Autodeclarado pelo tenant no momento em que sincroniza a agenda — não
  // há como o sistema verificar consentimento real, só registrar a
  // declaração de quem opera a conexão.
  consentStatus  String    @default("declared")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenantId     String
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // Número que estava pareado nesta conexão no momento em que este contato
  // foi sincronizado — carimbado aqui (não lido ao vivo de
  // connection.phoneNumber) porque o mesmo connectionId pode ser reutilizado
  // pra extrair agendas de números diferentes ao longo do tempo (ver
  // getOrCreateExtractedListForConnection); sem o carimbo, trocar o número
  // pareado/editar o campo da conexão reescreveria a origem de contatos já
  // sincronizados antes.
  originPhoneNumber String

  listMemberships    ContactListMember[]
  campaignRecipients CampaignRecipient[]

  @@unique([connectionId, phone])
  @@index([tenantId])
  @@map("contact")
}

enum ContactListType {
  // Nasce vinculada a um número (connectionId fixo, não editável depois de
  // criada) — é o resultado de "puxar" os contatos sincronizados de uma
  // conexão específica.
  EXTRACTED
  // Não pertence a nenhum número — montada à mão pelo tenant escolhendo
  // contatos de uma ou mais listas extraídas (possivelmente de números
  // diferentes). connectionId é sempre null nesse tipo.
  ASSEMBLED
}

model ContactList {
  id        String          @id @default(cuid())
  name      String
  type      ContactListType @default(EXTRACTED)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenantId     String
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // null para listas ASSEMBLED — só listas EXTRACTED têm número de origem.
  connectionId String?
  connection   ChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // JID do grupo (ex: "1202...-group") quando esta lista extraída veio de
  // "sincronizar de um grupo" em vez da agenda inteira do número — null
  // pra lista extraída "normal" (agenda toda) e sempre null pra ASSEMBLED.
  // Junto com o índice único abaixo, garante no máximo uma lista por grupo
  // por conexão (re-sincronizar o mesmo grupo atualiza a mesma lista).
  sourceGroupId String?

  // Carimbo do número pareado no momento da extração — mesma razão do
  // Contact.originPhoneNumber (ver ali). Null pra ASSEMBLED, sempre
  // preenchido pra EXTRACTED. Junto com connectionId (e sourceGroupId pra
  // listas de grupo), é o que diferencia "a mesma conexão, mas um número
  // diferente pareado depois" como uma lista nova em vez de reaproveitar a
  // antiga.
  originPhoneNumber String?

  members   ContactListMember[]
  campaigns Campaign[]

  @@unique([connectionId, sourceGroupId])
  @@index([tenantId, connectionId])
  @@map("contact_list")
}

model ContactListMember {
  id      String   @id @default(cuid())
  addedAt DateTime @default(now())

  listId String
  list   ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
  @@map("contact_list_member")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  messageText String
  // "image" | "video" | null (texto puro)
  mediaType   String?
  mediaUrl    String?
  status      CampaignStatus @default(DRAFT)

  // Overrides opcionais desta campanha — null usa o padrão gravado em
  // ConnectionCampaignSettings da conexão. Sempre resolvidos via
  // resolveCampaignSettings() no service, nunca lidos crus pelo worker.
  batchSize                 Int?
  minMessageIntervalSeconds Int?
  maxMessageIntervalSeconds Int?
  minBatchPauseSeconds      Int?
  maxBatchPauseSeconds      Int?

  // Checkbox obrigatório na tela de "iniciar campanha": declaração do
  // tenant de que tem base legal pra mandar mensagem pra essa lista — não
  // é uma verificação técnica (impossível de verificar de fato), só
  // registra que a decisão foi tomada conscientemente.
  consentConfirmed Boolean @default(false)

  // Motivo de uma pausa automática (ver seção "pausa automática" do
  // plano) — nulo quando pausada manualmente ou nunca pausada.
  pausedReason String?

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  tenantId     String
  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  listId String
  list   ContactList @relation(fields: [listId], references: [id])

  recipients CampaignRecipient[]

  @@index([tenantId, connectionId])
  @@index([connectionId, status])
  @@map("campaign")
}

enum CampaignRecipientStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
  OPTED_OUT
}

model CampaignRecipient {
  id           String                  @id @default(cuid())
  status       CampaignRecipientStatus @default(PENDING)
  attempts     Int                     @default(0)
  errorMessage String?
  // Marcado quando um worker reivindica a linha (PENDING → PROCESSING,
  // atômico via updateMany) — o mecanismo de lock que evita dois workers
  // enviando a mesma mensagem (ver campaign-dispatcher.service.ts). Um
  // recovery job reverte pra PENDING se ficar "processing" travado por
  // tempo demais (o servidor caiu no meio do envio).
  lockedAt     DateTime?
  scheduledAt  DateTime?
  sentAt       DateTime?
  deliveredAt  DateTime?
  failedAt     DateTime?

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@map("campaign_recipient")
}

// Ritmo de disparo por conexão — nunca compartilhado entre números, cada
// ChannelConnection tem a sua própria linha (seção "controle por
// número/conexão" do plano). Os defaults em
// config/whatsapp-campaign-defaults.ts só preenchem essa linha na
// primeira vez; dali em diante o tenant edita livremente pela tela de
// configuração da conexão — nada aqui é fixo no código.
model ConnectionCampaignSettings {
  id String @id @default(cuid())

  sendWindowStart String @default("07:30")
  sendWindowEnd   String @default("19:30")

  batchSize Int @default(5)

  minMessageIntervalSeconds Int @default(12)
  maxMessageIntervalSeconds Int @default(18)

  minBatchPauseSeconds Int @default(15)
  maxBatchPauseSeconds Int @default(20)

  // null = sem limite — a spec deste módulo é explícita: não existe um
  // número "seguro" universal, então não assumimos um teto por padrão.
  dailyLimit     Int?
  dailySentCount Int       @default(0)
  dailySentDate  DateTime?

  maxConsecutiveErrors Int @default(5)

  updatedAt DateTime @updatedAt

  connectionId String            @unique
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("connection_campaign_settings")
}

// =====================================================================
// Atendente de IA — responde mensagens recebidas no WhatsApp
// =====================================================================
// Primeiro incremento: motor + ativação por conexão. Handoff real pra um
// humano (fila/claim, como no desenho de roteamento de frota) é trabalho
// futuro — por enquanto "escalar" só marca a conversa como ESCALATED e o
// bot para de responder (ver bot-attendant.service.ts).

model BotConfig {
  id              String   @id @default(cuid())
  enabled         Boolean  @default(false)
  // Texto livre escrito pelo tenant (nome da empresa, regras do negócio,
  // preço mínimo, etc.) — anexado ao prompt de sistema da vertical escolhida
  // (ou ao BASE_SYSTEM_PROMPT legado, se nenhuma vertical foi escolhida).
  businessProfile String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  connectionId String            @unique
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  // Nicho de negócio escolhido pelo tenant (mobilidade, delivery, ...) — ver
  // BotVertical. Nullable pra não quebrar tenants que configuraram o bot
  // antes dessa coluna existir (cai no prompt legado de mobilidade).
  verticalId String?
  vertical   BotVertical? @relation(fields: [verticalId], references: [id])

  @@map("bot_config")
}

// Catálogo de nichos de negócio pro atendente de IA (mobilidade, delivery,
// ...) — mesmo padrão de catálogo code-extensible usado em
// whatsapp-notification-types.ts, mas as linhas (e principalmente o texto
// de `systemPrompt`, o "treino" de cada nicho) ficam no banco porque são
// editadas pelo Super Admin em /admin/whatsapp, não só por deploy.
model BotVertical {
  id       String  @id @default(cuid())
  key      String  @unique
  label    String
  systemPrompt String
  // Nichos com endereço de loja fixo (delivery, pizzaria, ...) vs. nichos
  // onde origem/destino são sempre livres por conversa (mobilidade) — usado
  // mais pra frente pra decidir se o tenant precisa cadastrar um endereço
  // fixo de referência; não consumido ainda em bot-attendant.service.ts.
  requiresFixedLocation Boolean @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  botConfigs BotConfig[]

  @@map("bot_vertical")
}

enum BotConversationStatus {
  ACTIVE
  // O modelo chamou a tool de transferência — bot fica em silêncio até um
  // futuro mecanismo de handoff/reabertura existir.
  ESCALATED
  CLOSED
}

model BotConversation {
  id            String                @id @default(cuid())
  contactPhone  String
  status        BotConversationStatus @default(ACTIVE)
  lastMessageAt DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  // Resumo curto do pedido em aberto no momento em que a IA escalou pra um
  // humano (ex: "Corrida de Rua X, 580 para Rua Y, 179") — preenchido pela
  // própria IA via o campo `resumoPedido` da ferramenta escalarParaHumano.
  // Usado só pra retomar o assunto quando o cliente escreve de novo (ver
  // handleInboundMessage em bot-attendant.service.ts); limpo quando o
  // pedido é encerrado (ferramenta encerrarPedido) ou a conversa reabre.
  pendingRequestSummary String?

  // Mensagens com `createdAt` antes disso nunca entram no histórico
  // mandado pro modelo (ver listRecentBotMessages + o filtro em
  // handleInboundMessage) — avança pra `now()` sempre que a conversa
  // reabre (CLOSED/ESCALATED -> ACTIVE) ou um pedido é encerrado.
  // Sem isso, o filtro de limpeza só valia no exato turno da reabertura:
  // na mensagem seguinte o histórico cru voltava a trazer o pedido antigo
  // (confirmado em produção — a IA voltou a falar de uma corrida já
  // encerrada dois turnos depois de supostamente ter "esquecido" dela).
  contextStartAt DateTime @default(now())

  // Corrida/entrega em acompanhamento nesta conversa (id + último status
  // conhecido, vindos de pedir_corrida/pedir_entrega/status_corrida — ver
  // bot-attendant.service.ts). Usado pra checar sozinho se mudou a cada
  // mensagem nova do cliente e avisar sem ele precisar perguntar —
  // stopgap até existir o webhook de status do MAI Drive (ver
  // docs/RESPOSTA-PARA-MAIDRIVE-WEBHOOK-STATUS.md). `null` = nada em
  // acompanhamento.
  openRideId     String?
  openRideStatus String?

  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  messages      BotMessage[]
  relaySessions RelaySession[]

  @@unique([connectionId, contactPhone])
  @@map("bot_conversation")
}

enum BotMessageDirection {
  IN
  OUT
}

model BotMessage {
  id        String              @id @default(cuid())
  direction BotMessageDirection
  body      String
  createdAt DateTime            @default(now())

  conversationId String
  conversation   BotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("bot_message")
}

// Departamento configurado pelo próprio tenant (ver setor.repository.ts) —
// escopado à ChannelConnection, igual BotConfig, não à Organization direto,
// porque o pool de atendentes é específico de um número de WhatsApp.
// `tenantId` fica denormalizado aqui (mesmo dado que dá pra pegar via
// connection.tenantId) só pra permitir o mesmo `updateMany({ where: { id,
// tenantId } })` de checagem de posse que update-balance-alert-phones.ts já
// usa, sem precisar de join em toda mutação tenant-scoped.
model Setor {
  id          String   @id @default(cuid())
  name        String
  // Texto livre do tenant descrevendo o que cai nesse setor — é isso que
  // alimenta o prompt da IA (ver buildSystemPrompt em bot-attendant.service.ts)
  // pra ela escolher por significado, não só pelo nome.
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Overrides futuros (fase 3 do plano) — colunas já existem pra não exigir
  // migration nova quando a UI de configurar timeout por setor existir;
  // nulo usa o default global em relay-session.service.ts.
  noClaimTimeoutMinutes    Int?
  inactivityTimeoutMinutes Int?

  tenantId     String
  organization Organization      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  attendants    SetorAttendant[]
  relaySessions RelaySession[]

  @@unique([connectionId, name])
  @@index([tenantId])
  @@map("setor")
}

// Um número do pool de atendentes de um setor. Tabela própria em vez de
// String[] em Setor — precisa de `active` por número (tirar de rotação sem
// apagar), unicidade por telefone, e índice pro lookup do lado do
// atendente (ver tryHandleRelayMessage em relay-session.service.ts).
model SetorAttendant {
  id        String   @id @default(cuid())
  phone     String
  label     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  setorId String
  setor   Setor  @relation(fields: [setorId], references: [id], onDelete: Cascade)

  @@unique([setorId, phone])
  @@map("setor_attendant")
}

enum RelaySessionStatus {
  PENDING
  ACTIVE
  CLOSED
}

// Uma linha por evento de escalação — não por conversa. Uma mesma
// BotConversation pode escalar, encerrar e escalar de novo depois; cada vez
// ganha sua própria RelaySession, sem conflito com a anterior já CLOSED
// (por isso conversationId é indexado, não @unique). `BotConversationStatus`
// continua só respondendo "a IA tá cuidando disso agora?" — a granularidade
// PENDING→ACTIVE→CLOSED do handoff é responsabilidade só desta tabela.
model RelaySession {
  id     String             @id @default(cuid())
  status RelaySessionStatus @default(PENDING)
  // Código curto (ex "A3F9") mandado no broadcast — o atendente responde
  // com ele pra reivindicar, e desambigua quando o mesmo atendente tem mais
  // de uma sessão PENDING ao mesmo tempo (ver tryHandleRelayMessage).
  code String @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  claimedAt DateTime?
  closedAt  DateTime?
  // "attendant_command" | "inactivity_timeout" | "no_claim_timeout"
  closeReason String?
  // Bumped em toda mensagem relayada (qualquer direção) — é isso, não
  // updatedAt, que o cron de timeout compara (ver closeStaleRelaySessions).
  lastActivityAt DateTime @default(now())

  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  setorId      String
  setor        Setor             @relation(fields: [setorId], references: [id], onDelete: Restrict)
  conversationId String
  conversation   BotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  customerPhone String
  // Telefone real do atendente que reivindicou — null enquanto PENDING.
  claimedByPhone String?
  // Snapshot de quem foi avisado no broadcast original — auditoria, não
  // muda depois (SetorAttendant pode mudar de pool sem afetar isto).
  broadcastedTo String[]

  claim RelaySessionClaim?

  @@index([connectionId, customerPhone, status])
  @@index([connectionId, claimedByPhone, status])
  @@index([connectionId, setorId, status])
  @@map("relay_session")
}

// Gate atômico "primeira resposta ganha" — espelha exatamente
// ProcessedWebhookMessage/tryClaimInboundMessage: insert-and-catch a
// violação de unique, nunca check-then-update, pra não ter janela de corrida
// entre duas respostas de atendente quase simultâneas.
model RelaySessionClaim {
  id             String       @id @default(cuid())
  relaySessionId String       @unique
  relaySession   RelaySession @relation(fields: [relaySessionId], references: [id], onDelete: Cascade)
  attendantPhone String
  claimedAt      DateTime     @default(now())

  @@map("relay_session_claim")
}

enum FlowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Fluxo conversacional visual (editor drag-and-drop no painel) — escopado
// por ChannelConnection, mesmo raciocínio de BotConfig/Setor: um fluxo é
// específico de um número de WhatsApp, não da Organization inteira.
// `draftGraph` é o que o editor mostra/salva a cada edição; `publishedGraph`
// é o snapshot que o motor (flow-engine.service.ts, ainda não construído)
// de fato executa — só avança quando o tenant aperta "Publicar", pra nunca
// mudar o comportamento de uma conversa em andamento no meio de uma edição.
model Flow {
  id             String     @id @default(cuid())
  name           String
  status         FlowStatus @default(DRAFT)
  draftGraph     Json
  publishedGraph Json?
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  sessions    FlowSession[]
  submissions FormSubmission[]

  @@index([connectionId, status])
  @@map("flow")
}

enum FlowSessionStatus {
  ACTIVE
  COMPLETED
}

// Estado de execução do fluxo por contato — em qual nó ele está agora e as
// variáveis já coletadas (origem/destino, resposta de uma pergunta, etc).
// Único por (connectionId, contactPhone), mesmo padrão de
// BotConversation: um contato só pode estar num ponto do fluxo por vez
// nesta conexão.
model FlowSession {
  id            String            @id @default(cuid())
  currentNodeId String?
  variables     Json              @default("{}")
  status        FlowSessionStatus @default(ACTIVE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  flowId String
  flow   Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)

  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  contactPhone String

  @@unique([connectionId, contactPhone])
  @@map("flow_session")
}

// Resposta completa de um nó `form` dentro de um Fluxo — gravada quando o
// contato confirma ("ENVIAR") depois de preencher todos os campos (ver
// flow-engine.service.ts). `answers` guarda {variable: valor} de cada campo
// do nó; `pdfUrl` fica nulo se a geração/upload do PDF falhar (não trava o
// atendimento por isso, ver form-submission.service.ts), e pode ser
// preenchido depois por um reprocessamento manual se precisar.
model FormSubmission {
  id           String   @id @default(cuid())
  title        String
  contactPhone String
  answers      Json
  pdfUrl       String?
  createdAt    DateTime @default(now())

  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  flowId String
  flow   Flow   @relation(fields: [flowId], references: [id], onDelete: Cascade)
  nodeId String

  @@index([connectionId, flowId])
  @@map("form_submission")
}

enum KnowledgeEntrySource {
  MANUAL
  CORRECTION
}

// Ficha de conhecimento que alimenta o prompt do atendente de IA (ver
// bot-attendant.service.ts) — igual BotConfig.businessProfile, mas em
// fichas curtas em vez de um textão só, pra o tenant (ou uma correção
// aceita, ver KnowledgeCorrection) adicionar/editar um item sem reescrever
// tudo. Escopada por connectionId pelo mesmo motivo de Setor/BotConfig.
// Consumo pelo motor da IA é trabalho de uma fase futura — esta é só a
// tabela.
model KnowledgeEntry {
  id        String               @id @default(cuid())
  title     String
  content   String
  active    Boolean              @default(true)
  source    KnowledgeEntrySource @default(MANUAL)
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  corrections KnowledgeCorrection[]

  @@index([connectionId, active])
  @@map("knowledge_entry")
}

enum KnowledgeCorrectionStatus {
  PENDING
  APPLIED
  DISMISSED
}

// Fila de correções apontadas pelo tenant/atendente sobre uma resposta real
// da IA ("treino por correção") — não altera o comportamento da IA
// sozinha; alguém revisa (hoje: nós, direto no banco; depois: um revisor no
// painel) e decide transformar isso numa KnowledgeEntry. Guarda a pergunta
// e a resposta errada só como contexto pra quem revisa.
model KnowledgeCorrection {
  id            String                    @id @default(cuid())
  customerPhone String?
  question      String
  wrongAnswer   String
  suggestedFix  String
  status        KnowledgeCorrectionStatus @default(PENDING)
  createdAt     DateTime                  @default(now())
  reviewedAt    DateTime?

  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  resultingEntryId String?
  resultingEntry   KnowledgeEntry? @relation(fields: [resultingEntryId], references: [id], onDelete: SetNull)

  @@index([connectionId, status])
  @@map("knowledge_correction")
}

// Linha única (singleton) — qual modelo de IA (string "provider/model" do
// AI Gateway da Vercel) o atendente usa. Controlado pelo Super Admin em
// /admin/whatsapp, não pelo tenant, pra poder trocar de modelo sem deploy.
model AiAttendantSettings {
  id        String   @id @default(cuid())
  model     String   @default("anthropic/claude-haiku-5.5")
  updatedAt DateTime @updatedAt

  @@map("ai_attendant_settings")
}

// Uma linha por resposta do atendente de IA (uma chamada de generateText em
// bot-attendant.service.ts) — tokens de entrada/saída e o custo em USD
// estimado a partir da tabela de preços do AI Gateway (ver
// lib/ai/gateway-pricing.ts). `costUsd` null quando o modelo configurado não
// está no catálogo do Gateway (ex: trocado pra uma string inédita) — ainda
// assim guarda os tokens pra não perder o dado. Consumido pelo Super Admin
// em /admin/whatsapp pra ver gasto de IA por conexão.
model AiUsageLog {
  id           String   @id @default(cuid())
  model        String
  inputTokens  Int?
  outputTokens Int?
  costUsd      Float?
  createdAt    DateTime @default(now())

  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
  @@map("ai_usage_log")
}

// Conexão com a API de dados de um app de negócio externo (hoje: MAI
// Drive) que alimenta o atendente de IA — ver docs/INTEGRACAO-MAIDRIVE.md.
// Divisão deliberada: MAIS ZAP nunca duplica/adivinha dado operacional
// (cidade atendida, cotação, disponibilidade, status de corrida); sempre
// consulta esse app via API. `provider` é code-extensible (igual
// ChannelProvider) pra quando existir um segundo app de negócio além do
// MAI Drive. Uma linha por `ChannelConnection` — "chave por central".
model BusinessIntegration {
  id        String   @id @default(cuid())
  provider  String // "mai-drive" hoje; outro valor quando existir um segundo app
  baseUrl   String // ex: "https://maidrive.app/api/whatsapp/v1"
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Chave de API (header x-api-key) pra chamar o app de negócio —
  // criptografada do mesmo jeito que ChannelConnection.apiTokenCipher (ver
  // lib/crypto/secret-box.ts), nunca em texto puro.
  apiKeyCipher String

  // Catálogo de serviços (GET /catalogo) cacheado — evita bater no app de
  // negócio a cada mensagem. `catalogFetchedAt` null = nunca buscado ainda.
  catalogJson      Json?
  catalogFetchedAt DateTime?

  connectionId String            @unique
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("business_integration")
}

// =====================================================================
// Auditoria
// =====================================================================

model AuditLog {
  id         String   @id @default(cuid())
  action     String // "tenant.updated", "member.invited", "role.permissions_changed", ...
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenantId     String?
  organization Organization? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorUserId])
  @@map("audit_log")
}
